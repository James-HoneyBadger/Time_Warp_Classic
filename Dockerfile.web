# Web edition of Time Warp Classic.
#
#   docker build -f Dockerfile.web -t timewarp-web .
#   docker run --rm -p 8000:8000 timewarp-web
#
# The browser UI serves the built-in interpreters.  Languages that delegate to
# an external runtime (JavaScript, Perl, plugins) need that runtime installed
# in the image - see docs/dev/WEB.md.
#
# There is no authentication: publish this only on trusted networks.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Pygments gives the browser editor syntax highlighting; without it the editor
# falls back to plain text, so this layer is optional but small.
RUN python -m pip install --no-cache-dir "pygments>=2.15.0"

COPY . .

# Optional: make the Node.js executor usable.
# RUN apt-get update \
#     && apt-get install -y --no-install-recommends nodejs \
#     && rm -rf /var/lib/apt/lists/*

RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"

CMD ["python", "Time_Warp.py", "--web", "--host", "0.0.0.0", "--port", "8000"]
